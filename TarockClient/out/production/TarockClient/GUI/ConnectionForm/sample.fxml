<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.*?>
<VBox prefHeight="210.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.ConnectionForm.ControllerConnectionForm">
  <children>
    <AnchorPane prefHeight="211.0" prefWidth="337.0" VBox.vgrow="ALWAYS">
      <children>
            <Button id="loginButton" layoutX="138.0" layoutY="150.0" mnemonicParsing="false" onAction="#clickedLoginButton" prefHeight="26.0" prefWidth="224.0" text="Login">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </Button>
            <TextField id="usernameField" layoutX="135.0" layoutY="10.0" prefHeight="37.0" prefWidth="350.0">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </TextField>
            <Label id="usernameLabel" layoutX="15.0" layoutY="10.0" prefHeight="37.0" prefWidth="120.0" text="Username : ">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </Label>
            <PasswordField id="passwordField" layoutX="135.0" layoutY="55.0" prefHeight="37.0" prefWidth="350.0">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </PasswordField>
            <Label id="passwordLabel" layoutX="15.0" layoutY="55.0" prefHeight="37.0" prefWidth="120.0" text="Password : ">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </Label>
            <Label id="ipAddressLabel" layoutX="15.0" layoutY="100.0" prefHeight="37.0" prefWidth="120.0" text="IP Address : ">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </Label>
            <TextField id="ipAddressField" layoutX="135.0" layoutY="100.0" prefHeight="37.0" prefWidth="350.0">
               <font>
                  <Font name="Arial" size="20.0" />
               </font>
            </TextField>
      </children>
    </AnchorPane>
  </children>
</VBox>
